		item "Minor pod fix."^^Documentation;
	].

`Marlin 0.002002 cpan:TOBYINK`
	issued  2025-12-13;
	changeset [
		item "Minor pod fix."^^Documentation;
	].

`Marlin 0.002003 cpan:TOBYINK`
	issued  2025-12-15;
	changeset [
		item "Fix case of MRO::Compat dependency on Perl older than v5.10.0."^^Bugfix;
	].

`Marlin 0.002004 cpan:TOBYINK`
	issued  2025-12-15;
	changeset [
		item "Remove usage of // operator."^^Bugfix;
	].

`Marlin 0.002005 cpan:TOBYINK`
	issued  2025-12-15;
	changeset [
		item "Remove usage of // operator from test case too."^^Bugfix;
	].

`Marlin 0.003000 cpan:TOBYINK`
	issued  2025-12-15;
	changeset [
		item "Use a newer version of Class::XSConstructor which allows for type coercion and defaults/builders to run in the constructor."^^Change;
	].

`Marlin 0.003001 cpan:TOBYINK`
	issued  2025-12-16;
	changeset [
		item "Use a newer version of Class::XSConstructor with fixes for BUILD methods."^^Change;
		item "Use a newer version of Sub::Accessor::Small with fixes for builder methods."^^Change;
	].

`Marlin 0.004000 cpan:TOBYINK`
	issued  2025-12-17;
	changeset [
		item "Allow attribute declarations to tweak how the attribute will be stored, including allowing inside-out attributes."^^Addition;
		item "Implement constant attributes."^^Addition;
	].

`Marlin 0.005000 cpan:TOBYINK`
	issued  2025-12-18;
	changeset [
		item "Use a newer version of Class::XSConstructor with support for destructors."^^Change;
		item "Use a newer version of Sub::Accessor::Small with improvements for triggers."^^Change;
	].

`Marlin 0.006000 cpan:TOBYINK`
	issued  2025-12-19;
	changeset [
		item "Use a newer version of Class::XSConstructor with support for trigger, weak_ref, and init_arg."^^Change;
		item "Changes upstream in Class::XSConstructor have broken one test in the test suite, so this has been marked TODO for now."^^Tests;
	].

`Marlin 0.006001 cpan:TOBYINK`
	issued  2025-12-19;
	changeset [
		item "Use a newer version of Class::XSConstructor which fixes broken test case."^^Change;
		item "Restore test case which was marked TODO."^^Tests;
	].

`Marlin 0.007000 cpan:TOBYINK`
	issued  2025-12-21;
	changeset [
		item "Marlin::Struct."^^Addition;
		item "Make strict constructors the default."^^Change;
	].

`Marlin 0.007001 cpan:TOBYINK`
	issued  2025-12-22;
	changeset [
		item "Get Marlin::Struct working on Perl older than 5.12.0."^^Bugfix;
	].

`Marlin 0.008000 cpan:TOBYINK`
	issued  2025-12-23;
	changeset [
		item "Omit -strict from examples as that is now the default."^^Documentation;
		item "Document API."^^Documentation;
		item "Better documentation of Marlin::Struct."^^Documentation;
		item "Marlin can now inherit from Moose and Moo classes and compose Moose and Moo roles."^^Change;
		item "Internally use Clone::clone() instead of Storage::dclone() as it can cope with coderefs."^^Change;
		item "Classes built with Marlin::Struct now provide a default stringification and arrayrefification."^^Change;
		item "Various small improvements to Marlin::Struct."^^Change;
		item "Provide some useful utility API methods."^^Change;
	].

`Marlin 0.009000 cpan:TOBYINK`
	issued  2025-12-28;
	changeset [
		item "Marlin now provides a rudimentary API for extension modules."^^Change;
		item "Marlin::X::Clone is bundled as a demonstration of the extension API (and because it can be useful)."^^Addition;
		item "Stop using `mkopt` to parse parameters; do it more manually to allow some options to take a simple string as their value instead of requiring a reference."^^Change;
	].

`Marlin 0.010000 cpan:TOBYINK`
	issued  2025-12-29;
	changeset [
		item "Marlin now provides a rudimentary API for attribute extension modules."^^Change;
		item "Marlin::XAttribute::Alias is bundled as a demonstration of the extension API (and because it can be useful)."^^Addition;
		item "Marlin::XAttribute::LocalWriter is bundled as a demonstration of the extension API (and because it can be useful)."^^Addition;
		item "Marlin::XAttribute::Lvalue is bundled as a demonstration of the extension API (and because it can be useful)."^^Addition;
		item "Show how easy it is to switch from Class::Tiny to Marlin."^^Documentation;
	].

`Marlin 0.011000 cpan:TOBYINK`
	issued  2026-01-07;
	changeset [
		item "Require Type::Tiny 2.010000."^^Packaging;
		item "Require Class::XSAccessor 0.016001."^^Packaging;
		item "Changes to work with newest Class::XSAccessor."^^Update;
		item "Support inheritance from Mouse classes and composing Mouse roles."^^Change;
		item "Support inheritance from Mite classes and composing Mite roles."^^Change;
		item "Support inheritance from Class::Tiny classes."^^Change;
		item "Marlin::XAttribute::Alias no longer forces PP constructors to be generated."^^Change;
		item "Move some attribute logic from Marlin to Marlin::Attribute making it easier for attribute extensions to override."^^Change;
		item "Marlin::Struct's magical coercion from arrayrefs is now aware of ':Alias'."^^Change;
		item "Provide MooseX::Marlin and MooX::Marlin to allow Moose and Moo to inherit from Marlin classes and compose Marlin roles."^^Addition;
	].

`Marlin 0.011001 cpan:TOBYINK`
	issued  2026-01-08;
	changeset [
		item "Require Class::XSAccessor 0.016002."^^Packaging;
		item "Marlin::XAttribute::Alias pod syntax fix."^^Bugfix;
		item "Marlin::X::Clone is now aware of Marlin::XAttribute::Alias."^^Change;
		item "Marlin::X::Clone documentation improvements."^^Documentation;
		item "Marlin::X::Clone now supports more on_clone options."^^Change;
		item "Marlin::X::Clone performance improvements."^^Change;
		item "Check that code is actually compiling before using B::Hooks::AtRuntime, otherwise just run stuff immediately."^^Change;
	].

`Marlin 0.011002 cpan:TOBYINK`
	issued  2026-01-09;
	changeset [
		item "Require Sub::Accessor::Small 1.000003."^^Packaging;
		item "Certain setup steps were not running correctly for roles."^^Bugfix;
		item "The before/after/around keywords exported to roles were ones only suitable for classes; they have been replaced with ones which work for roles."^^Bugfix;
		item "Update benchmark script; compare some more simple classes too."^^Documentation;
	].

`Marlin 0.012000 cpan:TOBYINK`
	issued  2026-01-11;
	changeset [
		item "Require Class::XSConstructor 0.018001."^^Packaging;
		item "Improvements to Class::XSConstructor mean we should never need to generate pure Perl constructors, so stripped out all the code to do that and replaced with a few shims to send the right options to Class::XSConstructor."^^Update;
		item "Marlin now has improved inheritance from foreign classes thanks to latest Class::XSConstructor."^^Documentation;
		item "Marlin now supports BUILDARGS thanks to latest Class::XSConstructor."^^Documentation;
		item "Update copyright years."^^Documentation;
	].

`Marlin 0.012001 cpan:TOBYINK`
	issued  2026-01-11;
	changeset [
		item "Better detection if parent classes use Class::XSConstructor directly."^^Bugfix;
	].

`Marlin 0.013000 cpan:TOBYINK`
	issued  2026-01-12;
	changeset [
		item "Moved a lot of the code for Moo/Moose compatibility into MooX::Marlin and MooseX::Marlin, so it clutters up the main Marlin modules less."^^Change;
		item "If you try to inherit from a class that uses Marlin::XAttribute::Alias in Moose, it will try to load MooseX::Aliases and use that, issuing a warning if the module is missing."^^Change;
		item "If you try to inherit from a class that uses Marlin::XAttribute::Lvalue in Moose, it will try to load MooseX::LvalueAttribute and use that, issuing a warning if the module is missing."^^Change;
		item "Attributes now support an undef_tolerant option."^^Addition;
		item "Marlin::X::UndefTolerant plugin to automatically apply undef_tolerant option to all attributes in a class or role (except those that don't make sense)."^^Addition;
		item "Add a test for foreign inheritance."^^Tests;
		item "Marlin::X::Clone understands about required attributes and undef_tolerant attributes."^^Change;
	].

`Marlin 0.013001 cpan:TOBYINK`
	issued  2026-01-12;
	changeset [
		item "Bump version of Class::XSConstructor dependency."^^Packaging;
	].

`Marlin 0.014000 cpan:TOBYINK`
	issued  2026-01-13;
	changeset [
		item "Bump version of Class::XSConstructor dependency."^^Packaging;
		item "Only bother creating a DESTROY method in classes which have (or inherit) a DEMOLISH method. Otherwise, there's no point as it just makes the object lifecycle slower even when implemented in XS."^^Change;
	].

`Marlin 0.015000 cpan:TOBYINK`
	issued  2026-01-15;
	changeset [
		item "Delay installation of DESTROY until after class has finished compiling; otherwise DEMOLISH methods might still not be defined yet."^^Bugfix;
		item "Improved tests for DESTROY."^^Tests;
		item "Eliminated dependency on Module::Runtime."^^Change;
		item "Eliminated dependency on Class::XSAccessor, though it is still listed as a dependency in META.json because it improves runtime speed when installed. In the future, when Class::XSConstructor is able to provide more accessor-like methods, Class::XSAccessor may be listed as a recommendation rather than a requirement."^^Change;
		item "Marlin own constructor (for objects blessed into the Marlin class) is now a strict XS constructor. Previously it was a Perl wrapper around the XS constructor; now it uses BUILDARGS to invert that.";
		item "Significant internal refactoring and code tidying, including dogfooding a lot of the modules."^^Change;
		item "Constructing a new Marlin::Attribute object with added traits won't cause canonicalize_opts to be called twice."^^Bugfix;
		item "Factor out common parts of Marlin extensions into Marlin::X, a role for use by people writing Marlin extensions."^^Change;
	].

`Marlin 0.016000 cpan:TOBYINK`
	issued  2026-01-16;
	changeset [
		item "Use attr=>{extends=>true} or Moose-like +attr to extend an inherited attribute."^^Change;
		item "Marlin now checks for conflicts between methods and init_args used by different attributes, so you can't (for example) have two attributes that have the same-named reader method."^^Change;
		item "An attribute that creates lexical accessors in a parent class won't automatically create matching ones in child classes."^^Change;
		item "Minor changes and reformatting of extended examples to make things cleaner."^^Documentation;
		item "In Perl versions too old to support lexical subs, use namespace::clean to clean away any non-lexical ones we wanted to be lexical."^^Change;
		item "Marlin::Attribute sometimes thought its link back to the package it was defined in was called `marlin` and sometimes `_marlin`; fix it to always be the former."^^Bugfix;
	].

`Marlin 0.020000 cpan:TOBYINK`
	issued  2026-01-19;
	changeset [
		item "The functionality of Marlin::XAttribute::Alias is now available in Marlin itself without needing an extension."^^Change;
		item "All other Marlin::X::* and Marlin::XAttribute::* modules are now distributed separately."^^Packaging;
		item "Eliminated dependency on LV as only Marlin::XAttribute::Lvalue required it."^^Change;
	].
